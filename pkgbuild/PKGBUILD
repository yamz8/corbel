pkgname=corbel
pkgver=0.1.0
pkgrel=1
pkgdesc='Punch lists on floor plans: pin defects, track them to done, export a closeout report'
arch=('x86_64' 'aarch64')
url='https://github.com/yamz8/corbel'
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'xdg-desktop-portal' 'poppler')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/corbel "$pkgdir/usr/bin/corbel"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/corbel.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/corbel.svg"
  install -Dm644 "$startdir/corbel.desktop" "$pkgdir/usr/share/applications/corbel.desktop"
  install -Dm644 "$startdir/corbel.xml" "$pkgdir/usr/share/mime/packages/corbel.xml"
}
